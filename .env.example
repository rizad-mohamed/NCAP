# Server-only runtime configuration. Actual credentials belong in ignored local files or host secrets.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=http://localhost:8080

# Required only on the server for shared authentication throttle counters.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Set to cloudflare only when Cloudflare is the trusted ingress that overwrites cf-connecting-ip.
AUTH_TRUST_PROXY=
